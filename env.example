# Copy to `.env` in the project root. The server loads this file automatically on startup.
# Get a key from https://www.meshy.ai/ — never commit real keys.
MESHY_API_KEY=

# Optional: SW5e compendium tooling (defaults in scripts — see static/data/sw5e_compendium/README.md).
# SW5E_PACKS_DIR=C:\path\to\GorGox-Interactive\starwars5edata\sw5e\static\packs
# Alternate folder when hydrating SQLite (omit to use static/data/sw5e_compendium).
# GORGOX_SW5E_COMP_PATH=
